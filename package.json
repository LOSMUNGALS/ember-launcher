{
  "name": "ember-launcher",
  "version": "1.0.3",
  "description": "An independent cross-platform desktop game library",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "electron .",
    "start:test-update": "npm run build && node scripts/start-test-update.mjs",
    "dev": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "package": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win portable",
    "package:installer": "npm run build && electron-builder --win nsis --publish never",
    "package:mac": "npm run build && electron-builder --mac zip --arm64",
    "accounts": "node --env-file-if-exists=.env server/index.mjs",
    "test:accounts": "node --test server/service.test.mjs",
    "smoke:accounts": "node scripts/verify-accounts.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "fs-chunk-store": "^5.0.1",
    "hls.js": "^1.7.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "webtorrent": "^3.0.21",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webtorrent": "^3.0.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "yazl": "^3.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "build": {
    "appId": "games.ember.launcher",
    "productName": "Ember",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.games",
      "icon": "public/launcher-source.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "Ember-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LOSMUNGALS",
        "repo": "ember-launcher",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false
  }
}
