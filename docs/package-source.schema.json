{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Ember package source v1","type":"object",
 "required":["version","id","name","packages"],
 "properties":{
  "version":{"const":1},"id":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,100}$"},"name":{"type":"string","minLength":1,"maxLength":150},"description":{"type":"string","maxLength":2000},
  "packages":{"type":"array","maxItems":1000,"items":{"type":"object","required":["id","gameId","title","version","type","platforms","bytes","url","sha256","filename","install","authorization"],"properties":{
   "id":{"type":"string","pattern":"^[A-Za-z0-9_-]+$","maxLength":200},"gameId":{"type":"string","pattern":"^[A-Za-z0-9_-]+$","maxLength":200},"steamAppId":{"type":"string","pattern":"^[0-9]+$"},"title":{"type":"string","minLength":1,"maxLength":200},"version":{"type":"string","minLength":1,"maxLength":200},
   "type":{"enum":["archive","installer","drm-free","multiplayer"]},"platforms":{"type":"array","minItems":1,"items":{"enum":["windows","mac"]}},"bytes":{"type":"integer","minimum":1,"maximum":1099511627776},"url":{"type":"string","format":"uri","pattern":"^https://"},"sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},"filename":{"type":"string","minLength":1,"maxLength":200},
   "install":{"oneOf":[{"type":"object","required":["method","executable"],"properties":{"method":{"const":"zip"},"executable":{"type":"string","minLength":1,"maxLength":500}}},{"type":"object","required":["method"],"properties":{"method":{"const":"installer"}}}]},
   "authorization":{"type":"object","required":["license","distribution","url"],"properties":{"license":{"type":"string","minLength":1},"distribution":{"type":"string","minLength":1},"url":{"type":"string","format":"uri","pattern":"^https://"}}}
  }}}
 }
}
