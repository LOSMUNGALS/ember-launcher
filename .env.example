# Server-only email configuration. Copy to .env; never commit real keys.
RESEND_API_KEY=
EMBER_EMAIL_FROM=Ember <accounts@your-verified-domain.example>
# Set this to the account website's HTTPS origin for remote users.
# Local testing defaults to http://127.0.0.1:4783.
# PUBLIC_URL=https://accounts.example.com
# Hosted account database. Server only; never put these in the launcher build.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
